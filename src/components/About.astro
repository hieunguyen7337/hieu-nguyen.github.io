---
// The first three categories are the CV's Skills section (AI variant) item for item;
// scripts/sitecheck.mjs reads the .tex and fails the build if one is missing. Research areas are
// site-only: each is backed by a project on this page, and reinforcement learning is
// owner-confirmed for the website (cv/facts.md F7.16).
const skillCategories = [
  {
    label: 'AI/ML',
    skills: [
      'RAG',
      'Vector search and quantisation',
      'Agentic workflows',
      'LLM orchestration',
      'Transformers',
      'NLP',
      'Speech recognition',
      'Computer vision',
      'Anomaly detection',
    ],
  },
  {
    label: 'Engineering',
    skills: [
      'Python',
      'Go',
      'TypeScript',
      'PostgreSQL',
      'pgvector',
      'MongoDB',
      'REST APIs',
      'React',
      'React Native',
      'Expo',
      'FastAPI',
      'Docker',
      'CI/CD',
      'Data pipelines',
    ],
  },
  {
    label: 'Cloud & infrastructure',
    skills: [
      'Azure (Functions, Cosmos DB)',
      'AWS (EC2, S3)',
      'Hetzner',
      'Cloudflare (WAF, R2 object storage)',
      'Caddy',
      'systemd',
    ],
  },
  {
    label: 'Research areas',
    skills: [
      'Person re-identification',
      'Pose estimation',
      'Bioinformatics',
      'Reinforcement learning',
    ],
  },
];
---

<section id="about" class="py-24">
  <div class="max-w-content mx-auto px-6">
    <h2 class="section-title">About Me</h2>
    <div
      class="border border-white/[0.08] bg-white/[0.04] rounded-2xl p-8 md:p-10 backdrop-blur-sm hover:border-indigo-500/30 transition-all duration-300"
    >
      <p class="text-slate-400 leading-[1.9] mb-10" style="font-size: 1.05rem;">
        I'm an AI and software engineer with 4 years of experience, based in Brisbane. My work connects production systems with practical evaluation: Python and Go services, retrieval, speech recognition and tool-using agents. At Plenarius, I led the migration of a research platform to Go and PostgreSQL. As CTO at Sleep Sage, I develop an education app with source-grounded learning cues, mobile audio and tested processing workflows. Earlier work at FPT Software and Viettel Post included acoustic anomaly detection on a Samsung factory floor and Vietnamese speech and NLP systems. I'm in the final semester of QUT's Master of Artificial Intelligence, with expected completion in November 2026. Alongside my Research Assistant role, I'm co-authoring a manuscript on planner and executor collaboration, currently in preparation. I also teach practical coding skills and lead university club projects.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6">
        {
          skillCategories.map((cat) => (
            <div>
              <h4 class="text-[11px] font-semibold text-cyan-400 tracking-[0.15em] uppercase mb-3">
                {cat.label}
              </h4>
              <div class="flex flex-wrap gap-2">
                {cat.skills.map((skill) => (
                  <span class="text-xs px-3 py-1 rounded-full bg-indigo-500/[0.08] text-slate-400 border border-indigo-500/20 hover:text-slate-200 hover:bg-indigo-500/15 transition-all duration-200 cursor-default">
                    {skill}
                  </span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
